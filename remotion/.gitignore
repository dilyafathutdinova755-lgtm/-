# Ignore the output video from Git but not videos you import into src/.
out
render.log

# Source footage lives in GitHub Releases (see LOAD-ME.md), not in git —
# GitHub rejects files over 100MB on a normal push anyway.
public/source.mp4
sources/

# ASR scratch: the model and generated intermediates are regenerable from
