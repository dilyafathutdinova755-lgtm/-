  ]},
  { "start": 11.49, "end": 15.78, "lines": [
    { "text": "УДИВИЛО, ВЕДЬ РАНЬШЕ", "accent": false, "size": "small" },
    { "text": "БРОСАЛ ЧЕРЕЗ НЕДЕЛЮ", "accent": true, "size": "big" }
  ]},
  { "start": 17.10, "end": 18.60, "lines": [
    { "text": "ПРОГРЕСС ПО ЦИФРАМ", "accent": false, "size": "small" },
