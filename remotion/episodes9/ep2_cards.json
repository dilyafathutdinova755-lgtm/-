  ]},
  { "start": 3.96, "end": 6.87, "lines": [
    { "text": "ЧЕСТНО ПОДВОЖУ", "accent": false, "size": "small" },
    { "text": "ПЕРВЫЙ ИТОГ", "accent": true, "size": "big" }
  ]},
  { "start": 8.22, "end": 11.16, "lines": [
    { "text": "НЕ БЫЛО НИ ДНЯ", "accent": false, "size": "small" },
