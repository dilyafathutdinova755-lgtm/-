  ]},
  { "start": 6.03, "end": 8.10, "lines": [
    { "text": "А НЕ ПРОСТО", "accent": false, "size": "small" },
    { "text": "СОГЛАШАТЬСЯ", "accent": true, "size": "big" }
  ]},
  { "start": 8.85, "end": 9.93, "lines": [
