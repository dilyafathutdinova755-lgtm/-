[
  { "start": 0.63, "end": 1.95, "lines": [
    { "text": "ЕГЭ ПОДГОТОВКУ", "accent": false, "size": "small" },
    { "text": "СТРОЮ ТАК", "accent": true, "size": "big" }
  ]},
  { "start": 2.10, "end": 5.55, "lines": [
