[
  {
    "start": 1.86,
    "end": 3.15,
    "lines": [
      {
        "text": "Я РЕШИЛ ГОТОВИТЬСЯ",
        "accent": false,
        "size": "small"
      },
      {
        "text": "ТОЛЬКО ПО НОВЫМ",
