        "size": "big"
      }
    ]
  },
  {
    "start": 3.15,
    "end": 4.38,
    "lines": [
      {
        "text": "ЗАДАНИЯМ ЧТОБЫ НЕ",
        "accent": false,
        "size": "small"
      },
      {
        "text": "ВИДЕТЬ ОДНО",
        "accent": true,
        "size": "big"
      }
    ]
  },
  {
    "start": 4.56,
    "end": 5.79,
    "lines": [
      {
        "text": "И ТО ЖЕ И НЕ СТАЛ",
