        "text": "СЛАБЫЕ МЕСТА",
        "accent": true,
        "size": "big"
      }
    ]
  },
  {
    "start": 9.18,
    "end": 9.99,
    "lines": [
      {
        "text": "ОСТАЮТСЯ",
        "accent": false,
        "size": "small"
      },
