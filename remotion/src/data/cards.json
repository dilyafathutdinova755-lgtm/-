      },
      {
        "text": "ПОВТОРЯТЬ",
        "accent": true,
        "size": "big"
      }
    ]
  },
  {
    "start": 6.15,
    "end": 7.02,
    "lines": [
      {
        "text": "НОВОЕ ЭТО",
