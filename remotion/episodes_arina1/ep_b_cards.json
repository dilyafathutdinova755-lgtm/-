[
  { "start": 2.31, "end": 4.95, "lines": [
    { "text": "ЧЕСТНО ДОЧЬ ПЕРЕСТАЛА", "accent": false, "size": "small" },
    { "text": "РАССКАЗЫВАТЬ", "accent": true, "size": "big" }
  ]},
  { "start": 5.28, "end": 7.56, "lines": [
    { "text": "И ЭТО ЗАДЕЛО", "accent": false, "size": "small" },
    { "text": "БОЛЬШЕ ЧЕМ БАЛЛЫ", "accent": true, "size": "big" }
  ]},
  { "start": 8.25, "end": 9.75, "lines": [
    { "text": "РАНЬШЕ ДЕЛИЛАСЬ", "accent": false, "size": "small" },
