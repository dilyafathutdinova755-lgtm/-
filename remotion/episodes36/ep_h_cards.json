[
  { "start": 2.51, "end": 4.22, "lines": [
    { "text": "ПО КОНКРЕТНОЙ ТЕМЕ", "accent": false, "size": "small" },
    { "text": "СЧИТАЕШЬ ГОТОВОЙ", "accent": true, "size": "big" }
  ]},
  { "start": 4.25, "end": 8.06, "lines": [
    { "text": "КОГДА ОДИН РАЗ", "accent": false, "size": "small" },
    { "text": "РЕШИЛ БЕЗ ОШИБОК", "accent": true, "size": "big" }
  ]},
  { "start": 8.09, "end": 10.10, "lines": [
    { "text": "НО ЭТО ОЩУЩЕНИЕ", "accent": false, "size": "small" },
