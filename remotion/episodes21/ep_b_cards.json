[
  { "start": 3.33, "end": 4.68, "lines": [
    { "text": "ДЛЯ ПОРОГА", "accent": false, "size": "small" },
    { "text": "ИЗ ПРИНЦИПА", "accent": true, "size": "big" }
  ]},
  { "start": 4.77, "end": 7.08, "lines": [
    { "text": "НЕ ВЫКЛАДЫВАТЬСЯ", "accent": false, "size": "small" },
    { "text": "В СИСТЕМУ", "accent": true, "size": "big" }
  ]},
  { "start": 7.44, "end": 8.61, "lines": [
    { "text": "В КАКОЙ-ТО", "accent": false, "size": "small" },
